# ─── Variante d'installation — à définir UNE FOIS par serveur ────────────────
# Docker Compose lit ces deux variables ici : une fois renseignées, la commande
#     docker compose pull && docker compose up -d
# fait ce qu'il faut sur CE serveur, sans avoir à se rappeler du -f ni du --profile.
#
# • La galerie gère elle-même HTTPS (Caddy inclus, ports 80/443 libres) :
#   laissez les deux lignes commentées, c'est le comportement par défaut.
#
# • Derrière un Traefik déjà présent :
#COMPOSE_FILE=docker-compose.traefik.yml
#COMPOSE_PROFILES=autoupdate
#
# • Derrière un autre reverse proxy (nginx, Nginx Proxy Manager, Cloudflare Tunnel…) :
#COMPOSE_FILE=docker-compose.proxy.yml
#COMPOSE_PROFILES=autoupdate
#
# COMPOSE_PROFILES=autoupdate démarre le Watchtower dédié (mises à jour
# quotidiennes, limité au seul conteneur de la galerie par son scope).
# À omettre si un Watchtower de l'hôte couvre déjà tous les conteneurs.

# --- Domaine (HTTPS automatique via Caddy) ---
# Le DNS de ce domaine doit pointer vers l'IP du VPS
DOMAIN=galerie.exemple.com

# Ports hôte de Caddy, si 80/443 sont déjà pris sur la machine mais libres côté
# public (box/routeur) : ex. 8080/8443, avec redirection publique 80→8080 et 443→8443
#HTTP_PORT=80
#HTTPS_PORT=443

# --- Google Drive (mêmes valeurs que sur Vercel) ---
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxx
# Valeur initiale ; ensuite l'app PhotoCall la met à jour via ADMIN_TOKEN (fichier data/refresh-token)
GOOGLE_OAUTH_REFRESH_TOKEN=xxxx

# --- Synchro du jeton Drive depuis l'app PhotoCall ---
# Générez une valeur aléatoire longue (ex. : openssl rand -hex 32)
# et collez-la aussi dans PhotoCall → Options → Galerie autohébergée
ADMIN_TOKEN=

# --- Emails (au choix) ---
# Option A : Resend
#RESEND_API_KEY=re_xxxx
#RESEND_FROM=SnapMe <noreply@votredomaine.com>
# Option B : SMTP classique (OVH, Gmail, Brevo…)
#SMTP_HOST=smtp.exemple.com
#SMTP_PORT=587
#SMTP_USER=contact@exemple.com
#SMTP_PASS=xxxx
#SMTP_FROM=SnapMe <contact@exemple.com>
